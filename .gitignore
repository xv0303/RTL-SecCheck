# NEVER COMMIT this file - it contains your LLM API key
backend/settings.json

# local venv & caches
backend/.venv/
__pycache__/
*.pyc

# bundled analysis engines: keep environments and generated data local
third_party/*/.venv/
third_party/*/.git/
third_party/*/outputs/
third_party/*/.env
third_party/*/__pycache__/
third_party/*/parser.out
third_party/*/parsetab.py

# scan results (local data, may contain proprietary RTL)
scans/

# runtime logs & parser cache (auto-regenerated)
backend/service.log
backend/parser.out
backend/parsetab.py

# local test artifacts
backend/lavd_test.json

# machine-specific helper (LAN autostart)
run_hidden.vbs
